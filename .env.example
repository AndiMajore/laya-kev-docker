# laya-gpu configuration. Copy to .env (`make env`) and edit.
# Empty values fall back to the servers' own defaults.

# --- Which servers to run ------------------------------------------------------
# Compose files to use, colon-separated: compose.laya.yaml, compose.kev.yaml or both.
# Both servers speak the same /v1/systemone API on their own port.
COMPOSE_FILE=compose.laya.yaml

# --- Images -------------------------------------------------------------------
# Registry path of the published images (CI pushes <prefix>/laya and <prefix>/kev).
IMAGE_PREFIX=ghcr.io/andimajore/laya-kev-docker

# --- Build (also used by CI; rebuild after changing: `make up`) -------------
# laya release from PyPI.
LAYA_VERSION=0.3.9
# kev commit (or tag/branch) from github.com/jaredpalmer/kev.
KEV_REF=557598fced1dada75dfbf36ed144dce309ac6ceb
# PyTorch CUDA wheel index: cu126, cu128, cu129 ... Must be supported by your
# host driver (see `nvidia-smi`, "CUDA Version").
TORCH_INDEX=cu128
# Build network: default, or host if pip cannot resolve DNS during the build
# (common behind VPNs).
BUILD_NETWORK=default

# --- GPU / host --------------------------------------------------------------
# Host GPU index or UUID; it appears as cuda:0 inside the container.
LAYA_GPU_ID=0
# GPU for kev; defaults to LAYA_GPU_ID.
# KEV_GPU_ID=1
# Host interface to publish both servers on; 127.0.0.1 keeps the API local-only.
LAYA_BIND=0.0.0.0
# Docker volume holding the downloaded checkpoints.
LAYA_CACHE_VOLUME=laya-gpu-hf-cache

# --- Server (laya-serve) -----------------------------------------------------
# Port inside the container and on the host.
LAYA_PORT=8000
# Torch device: cuda, cuda:0, cpu. Empty = auto.
LAYA_DEVICE=cuda
# 1 = load checkpoints at startup, 0 = on first request.
LAYA_PRELOAD=1
# Checkpoints to preload: english, multilingual, typed-decisions (comma list).
# Empty = all three (~2.5 GB download, ~3 GB VRAM).
LAYA_MODELS=english,multilingual
# 1 = auto-route recognised workflows to the typed-decisions checkpoint.
LAYA_AUTO_TASK=0
# uvicorn log level: critical, error, warning, info, debug.
LAYA_LOG_LEVEL=info
# Cap torch CPU threads (only matters for CPU work). Empty = torch default.
LAYA_THREADS=

# --- Server (kev) -------------------------------------------------------------
KEV_PORT=8001
# Hub id (optionally @revision) or a local run directory. VRAM in bf16:
# jaredpalmer/kev-0.8b ~2 GB, jaredpalmer/kev-4b ~9 GB, jaredpalmer/kev-9b ~20 GB.
KEV_MODEL=jaredpalmer/kev-0.8b
# bf16 (GPU default), fp16, or fp32 (the exact path kev's evaluations use).
KEV_DTYPE=
# 1 = append day counts between absolute dates in the state (kev cannot subtract dates).
KEV_DATE_FACTS=0
# Override the checkpoint's calibrated temperature. Empty = shipped value.
KEV_TEMPERATURE=
# 1 = refuse to start without CUDA instead of silently serving on CPU.
KEV_REQUIRE_CUDA=1
KEV_LOG_LEVEL=info

# --- Auth --------------------------------------------------------------------
# If set, requests need `Authorization: Bearer <key>`. Empty = open API.
LAYA_API_KEY=
KEV_API_KEY=
# Alternative: path to a mounted secret file (see compose.yaml volumes).
# LAYA_API_KEY_FILE=/run/secrets/laya_api_key
# KEV_API_KEY_FILE=/run/secrets/kev_api_key

# --- Hugging Face ------------------------------------------------------------
# Public checkpoints need no token.
# HF_TOKEN=hf_...
# HF_TOKEN_FILE=/run/secrets/hf_token
# 1 = never download, use only the cached weights in the hf-cache volume.
HF_HUB_OFFLINE=0
